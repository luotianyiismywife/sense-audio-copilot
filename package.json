{
	"name": "senseaudio-copilot-provider",
	"publisher": "luotianyiismywife",
	"displayName": "SenseAudio Provider for Copilot",
	"description": "Integrate SenseAudio models into GitHub Copilot Chat. API keys available from the author (see README). Note: the platform has no prompt cache hits, so quota is consumed faster than cache-enabled platforms.",
	"keywords": [
		"ai",
		"chat",
		"copilot",
		"github-copilot",
		"language-models",
		"llm",
		"senseaudio",
		"openai-compatible",
		"thinking",
		"git-commit"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/luotianyiismywife/senseaudio-copilot"
	},
	"homepage": "https://github.com/luotianyiismywife/senseaudio-copilot",
	"bugs": {
		"url": "https://github.com/luotianyiismywife/senseaudio-copilot/issues"
	},
	"version": "1.5.0",
	"engines": {
		"vscode": "^1.116.0"
	},
	"categories": [
		"AI",
		"Chat"
	],
	"license": "AGPL-3.0",
	"activationEvents": [
		"onStartupFinished"
	],
	"contributes": {
		"languageModelChatProviders": [
			{
				"vendor": "senseaudio",
				"displayName": "%providerDisplayName%",
				"managementCommand": "senseaudio.manageApiKeys"
			}
		],
		"commands": [
			{
				"command": "senseaudio.openSettings",
				"category": "%commandCategory%",
				"title": "%command.openSettings%"
			},
			{
				"command": "senseaudio.generateGitCommitMessage",
				"title": "%command.generateCommit%",
				"category": "%commandCategory%",
				"icon": "$(wand)"
			},
			{
				"command": "senseaudio.abortGitCommitMessage",
				"title": "%command.abortCommit%",
				"category": "%commandCategory%",
				"icon": "$(debug-stop)"
			},
			{
				"command": "senseaudio.manageApiKeys",
				"category": "%commandCategory%",
				"title": "%command.manageApiKeys%"
			},
			{
				"command": "senseaudio.syncPush",
				"category": "%commandCategory%",
				"title": "%command.syncPush%"
			},
			{
				"command": "senseaudio.syncPull",
				"category": "%commandCategory%",
				"title": "%command.syncPull%"
			},
			{
				"command": "senseaudio.checkUsage",
				"category": "%commandCategory%",
				"title": "%command.checkUsage%"
			}
		],
		"walkthroughs": [
			{
				"id": "tokenRhythmGettingStarted",
				"title": "%walkthrough.title%",
				"description": "%walkthrough.description%",
				"steps": [
					{
						"id": "setApiKey",
						"title": "%walkthrough.setApiKey.title%",
						"description": "%walkthrough.setApiKey.description%",
						"media": {
							"markdown": "resources/walkthrough/set-api-key.md"
						},
						"completionEvents": [
							"onCommand:senseaudio.manageApiKeys"
						]
					},
					{
						"id": "showModels",
						"title": "%walkthrough.showModels.title%",
						"description": "%walkthrough.showModels.description%",
						"media": {
							"markdown": "resources/walkthrough/show-models.md"
						}
					},
					{
						"id": "advancedSettings",
						"title": "%walkthrough.advancedSettings.title%",
						"description": "%walkthrough.advancedSettings.description%",
						"media": {
							"markdown": "resources/walkthrough/advanced-settings.md"
						}
					}
				]
			}
		],
		"menus": {
			"scm/title": [
				{
					"command": "senseaudio.generateGitCommitMessage",
					"group": "navigation",
					"when": "config.git.enabled && scmProvider == git && !senseaudio.isGeneratingCommit"
				},
				{
					"command": "senseaudio.abortGitCommitMessage",
					"group": "navigation",
					"when": "config.git.enabled && scmProvider == git && senseaudio.isGeneratingCommit"
				}
			],
			"commandPalette": [
				{
					"command": "senseaudio.generateGitCommitMessage",
					"when": "config.git.enabled && !senseaudio.isGeneratingCommit"
				},
				{
					"command": "senseaudio.abortGitCommitMessage",
					"when": "config.git.enabled && senseaudio.isGeneratingCommit"
				},
				{
					"command": "senseaudio.checkUsage",
					"when": "false"
				}
			]
		},
		"configuration": {
			"title": "%config.title%",
			"properties": {
				"senseaudio.commitLanguage": {
					"type": "string",
					"default": "auto",
					"enum": [
						"auto",
						"English",
						"French",
						"Italian",
						"German",
						"Spanish",
						"Russian",
						"Chinese (Simplified)",
						"Chinese (Traditional)",
						"Japanese",
						"Korean",
						"Czech",
						"Portuguese (Brazil)",
						"Turkish",
						"Polish"
					],
					"enumDescriptions": [
						"%config.commitLanguage.auto.desc%",
						"%config.commitLanguage.enum.English.desc%",
						"%config.commitLanguage.enum.French.desc%",
						"%config.commitLanguage.enum.Italian.desc%",
						"%config.commitLanguage.enum.German.desc%",
						"%config.commitLanguage.enum.Spanish.desc%",
						"%config.commitLanguage.enum.Russian.desc%",
						"%config.commitLanguage.enum.ChineseSimplified.desc%",
						"%config.commitLanguage.enum.ChineseTraditional.desc%",
						"%config.commitLanguage.enum.Japanese.desc%",
						"%config.commitLanguage.enum.Korean.desc%",
						"%config.commitLanguage.enum.Czech.desc%",
						"%config.commitLanguage.enum.PortugueseBrazil.desc%",
						"%config.commitLanguage.enum.Turkish.desc%",
						"%config.commitLanguage.enum.Polish.desc%"
					],
					"description": "%config.commitLanguage.desc%"
				},
				"senseaudio.commitModel": {
					"type": "string",
					"default": "glm-5.3-flash",
					"description": "%config.commitModel.desc%"
				},
				"senseaudio.commitMessagePrompt": {
					"type": "string",
					"default": "",
					"description": "%config.commitMessagePrompt.desc%"
				},
				"senseaudio.requestTimeout": {
					"type": "number",
					"default": 600000,
					"minimum": 10000,
					"description": "%config.requestTimeout.desc%"
				},
				"senseaudio.recentCommitsCount": {
					"type": "number",
					"default": 10,
					"minimum": 0,
					"maximum": 50,
					"description": "%config.recentCommitsCount.desc%"
				},
				"senseaudio.commitIncludeCommitDiff": {
					"type": "boolean",
					"default": false,
					"description": "%config.commitIncludeCommitDiff.desc%"
				},
				"senseaudio.commitAttachContextFiles": {
					"type": "boolean",
					"default": true,
					"description": "%config.commitAttachContextFiles.desc%"
				},
				"senseaudio.modelPreset": {
					"type": "string",
					"default": "custom",
					"description": "%config.modelPreset.desc%",
					"editPresentation": "singlelineText"
				},
				"senseaudio.temperature": {
					"type": "number",
					"default": 1,
					"minimum": 0,
					"maximum": 2,
					"description": "%config.temperature.desc%"
				},
				"senseaudio.top_p": {
					"type": "number",
					"default": 0.5,
					"minimum": 0,
					"maximum": 1,
					"description": "%config.top_p.desc%"
				},
				"senseaudio.enableAutoModelDiscovery": {
					"type": "boolean",
					"default": true,
					"description": "%config.enableAutoModelDiscovery.desc%"
				},
				"senseaudio.syncModelsOnStartup": {
					"type": "boolean",
					"default": true,
					"description": "%config.syncModelsOnStartup.desc%"
				},
				"senseaudio.maxInputTokensRatio": {
					"type": "number",
					"default": 1.0,
					"minimum": 0.1,
					"maximum": 1.0,
					"description": "%config.maxInputTokensRatio.desc%"
				},
				"senseaudio.modelPresets": {
					"type": "array",
					"default": [
						{
							"id": "precise",
							"label": "Precise",
							"temperature": 0
						},
						{
							"id": "balanced",
							"label": "Balanced",
							"temperature": 1
						},
						{
							"id": "creative",
							"label": "Creative",
							"temperature": 1.2
						},
						{
							"id": "extra-creative",
							"label": "Extra Creative",
							"temperature": 1.7
						}
					],
					"items": {
						"type": "object",
						"required": [
							"id",
							"label",
							"temperature"
						],
						"properties": {
							"id": {
								"type": "string",
								"description": "%config.modelPreset.id.desc%"
							},
							"label": {
								"type": "string",
								"description": "%config.modelPreset.label.desc%"
							},
							"temperature": {
								"type": "number",
								"description": "%config.modelPreset.temperature.desc%"
							},
							"top_p": {
								"type": "number",
								"description": "%config.modelPreset.top_p.desc%"
							}
						}
					},
					"description": "%config.modelPresets.desc%"
				},
				"senseaudio.visionProxyModel": {
					"type": "string",
					"default": "qwen3.6-35b-a3b",
					"description": "%config.visionProxyModel.desc%"
				},
				"senseaudio.visionProxyThinking": {
					"type": "boolean",
					"default": false,
					"description": "%config.visionProxyThinking.desc%"
				},
				"senseaudio.enableThirdPartyTokenIndicator": {
					"type": "boolean",
					"default": false,
					"description": "%config.enableThirdPartyTokenIndicator.desc%"
				},
				"senseaudio.apiMode": {
					"type": "string",
					"default": "auto",
					"enum": ["auto", "openai", "anthropic", "responses"],
					"enumDescriptions": [
						"%config.apiMode.enum.auto.desc%",
						"%config.apiMode.enum.openai.desc%",
						"%config.apiMode.enum.anthropic.desc%",
						"%config.apiMode.enum.responses.desc%"
					],
					"description": "%config.apiMode.desc%"
				},
				"senseaudio.enableResponsesApi": {
					"type": "boolean",
					"default": false,
					"description": "%config.enableResponsesApi.desc%"
				},
				"senseaudio.enableAnthropicApi": {
					"type": "boolean",
					"default": false,
					"description": "%config.enableAnthropicApi.desc%"
				},
				"senseaudio.apiKeyMode": {
					"type": "string",
					"enum": ["sticky", "rotation", "single"],
					"default": "sticky",
					"enumDescriptions": [
						"%config.apiKeyMode.enum.sticky.desc%",
						"%config.apiKeyMode.enum.rotation.desc%",
						"%config.apiKeyMode.enum.single.desc%"
					],
					"description": "%config.apiKeyMode.desc%"
				},
				"senseaudio.singleKeyFallback": {
					"type": "string",
					"enum": ["error", "switch"],
					"default": "switch",
					"enumDescriptions": [
						"%config.singleKeyFallback.enum.error.desc%",
						"%config.singleKeyFallback.enum.switch.desc%"
					],
					"description": "%config.singleKeyFallback.desc%"
				},
				                                "senseaudio.errorRules": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "code": { "type": "string", "description": "Error body error.code field (exact match, primary match field)" },
                                            "message": { "type": "string", "description": "Descriptive label only (not used for matching)" },
                                            "statusCode": { "type": "number", "description": "HTTP status code fallback" },
                                            "action": { "type": "string", "enum": ["retrySameKey", "rotateCooldown", "rotatePersist"] }
                                        },
                                        "required": ["action"]
                                    },
                                    "default": [
                                        { "code": "billing", "message": "计费账户已被冻结（封号）", "action": "rotatePersist" },
                                        { "code": "upstream_stream_error", "message": "上游模型流意外中断", "action": "retrySameKey" },
                                        { "code": "INSUFFICIENT_BALANCE", "message": "余额不足", "action": "rotatePersist" },
                                        { "statusCode": 401, "message": "无效 key", "action": "rotatePersist" },
                                        { "statusCode": 402, "message": "余额不足", "action": "rotatePersist" },
                                        { "statusCode": 429, "message": "限流", "action": "rotateCooldown" },
                                        { "statusCode": 503, "message": "服务端繁忙", "action": "rotateCooldown" },
                                        { "statusCode": 400, "message": "上游中断复用 400", "action": "retrySameKey" },
                                        { "statusCode": 500, "message": "内部错误", "action": "retrySameKey" }
                                    ],
                                    "description": "%config.errorRules.desc%"
                                },"senseaudio.apiKeyExhaustedCooldownMin": {
					"type": "number",
					"default": 10,
					"minimum": 0,
					"description": "%config.apiKeyExhaustedCooldownMin.desc%"
				},
				"senseaudio.transientRetryTimes": {
					"type": "number",
					"default": 3,
					"minimum": 0,
					"maximum": 10,
					"description": "%config.transientRetryTimes.desc%"
				},
				"senseaudio.cloudSyncAutoPull": {
					"type": "boolean",
					"default": true,
					"description": "%config.cloudSyncAutoPull.desc%"
				},
				"senseaudio.cloudSyncAutoPush": {
					"type": "boolean",
					"default": false,
					"description": "%config.cloudSyncAutoPush.desc%"
				},
				"senseaudio.showUsageInStatusBar": {
					"type": "boolean",
					"default": true,
					"description": "%config.showUsageInStatusBar.desc%"
				},
				"senseaudio.showUsageInTooltip": {
					"type": "boolean",
					"default": true,
					"description": "%config.showUsageInTooltip.desc%"
				},
				"senseaudio.usageRefreshInterval": {
					"type": "number",
					"default": 5,
					"minimum": 1,
					"maximum": 60,
					"description": "%config.usageRefreshInterval.desc%"
				},
				"senseaudio.minBalanceCny": {
					"type": "number",
					"default": 0,
					"minimum": 0,
					"description": "%config.minBalanceCny.desc%"
				},
				"senseaudio.balanceCheckIntervalSec": {
					"type": "number",
					"default": 60,
					"minimum": 0,
					"description": "%config.balanceCheckIntervalSec.desc%"
				},
				"senseaudio.delay": {
					"type": "number",
					"default": 0,
					"minimum": 0,
					"description": "%config.delay.desc%"
				},
				"senseaudio.readFileLines": {
					"type": "number",
					"default": 0,
					"minimum": 0,
					"description": "%config.readFileLines.desc%"
				},
				"senseaudio.visionMaxRounds": {
					"type": "number",
					"default": 5,
					"minimum": 1,
					"maximum": 20,
					"description": "%config.visionMaxRounds.desc%"
				},
				"senseaudio.retry.enabled": {
					"type": "boolean",
					"default": true,
					"description": "%config.retry.enabled.desc%"
				},
				"senseaudio.retry.maxAttempts": {
					"type": "number",
					"default": 2,
					"minimum": 1,
					"maximum": 10,
					"description": "%config.retry.maxAttempts.desc%"
				},
				"senseaudio.retry.intervalMs": {
					"type": "number",
					"default": 1000,
					"minimum": 0,
					"description": "%config.retry.intervalMs.desc%"
				},
				"senseaudio.retry.statusCodes": {
					"type": "array",
					"items": {
						"type": "number"
					},
					"default": [],
					"description": "%config.retry.statusCodes.desc%"
				}
			}
		}
	},
	"main": "./out/extension.js",
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"clean": "node scripts/build/clean.mjs",
		"compile": "node scripts/build/clean.mjs && tsc -p ./ && node scripts/build/build-info.mjs && node scripts/dev/check-settings.mjs",
		"audit": "node scripts/dev/audit-all.mjs",
		"lint": "eslint",
		"watch": "tsc -watch -p ./",
		"test": "npm run compile && npm run test:offline",
		"test:offline": "node test/test-plan-usage.mjs && node test/test-transient-retry.mjs && node test/test-vision-history.mjs && node test/test-anthropic-tool-result-merge.mjs && node test/test-anthropic-image-index.mjs && node test/test-anthropic-vision-order.mjs && node test/test-image-dimensions.mjs && node test/test-sse-stream.mjs && node test/test-batch-import.mjs && node test/test-cloud-sync-auto-push.mjs && node test/test-cloud-sync-flow.mjs",
		"test:e2e": "node test/test-cloud-sync-e2e.mjs",
		"build": "node scripts/build/package-vsix.mjs",
		"postinstall": "node scripts/build/copy-tokenizer.js"
	},
	"dependencies": {
		"@microsoft/tiktokenizer": "^1.0.10"
	},
	"devDependencies": {
		"@eslint/js": "9.39.4",
		"@types/node": "^22",
		"@types/vscode": "^1.116.0",
		"eslint": "9.39.4",
		"typescript": "^5.9.2",
		"typescript-eslint": "8.60.1"
	}
}
